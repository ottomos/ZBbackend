# ============================================================================
# Environment Configuration Template
# ============================================================================
# Copy this file to .env and fill in your actual values for your environment
# DO NOT use localhost values - these must match your actual infrastructure

# ============================================================================
# MSSQL Database Configuration - SQL Authentication
# ============================================================================
DB_AUTH_TYPE=default
DB_USER=<your_db_user>
DB_PASSWORD=<your_db_password>
DB_SERVER=<your_db_server_ip_or_hostname>
DB_DATABASE=<your_database_name>
DB_PORT=1433
DB_INSTANCE=
DB_ENCRYPT=false
DB_TRUST_CERTIFICATE=true

# ============================================================================
# Kafka Brokers Configuration
# ============================================================================
# IMPORTANT: Set these to your actual Kafka broker addresses
# Example: stlkafka1:9092,stlkafka2:9092,stlkafka3:9092
KAFKA_BROKER_KFH=<comma_separated_kafka_brokers>
KAFKA_BROKER_KT=<comma_separated_kafka_brokers>
KAFKA_BROKER_AUB=<comma_separated_kafka_brokers>

# ============================================================================
# Server Configuration
# ============================================================================
PORT=5000
NODE_ENV=development

# ============================================================================
# Next.js Frontend Configuration
# ============================================================================
# Set these in kafka-nextjs-dashboard/.env.local or pass to Docker
NEXT_PUBLIC_API_URL=http://<your_backend_server>:4000/api
NEXT_PUBLIC_DB_API_URL=http://<your_backend_server>:5000/api

# ============================================================================
# Mail Configuration (SMTP)
# ============================================================================
# For internal email sending via send-mail API
MAIL_HOST=<your_smtp_server>
MAIL_PORT=587
MAIL_SECURE=false
MAIL_REQUIRE_TLS=true
MAIL_USER=<your_smtp_user>
MAIL_PASS=<your_smtp_password>
MAIL_FROM=<sender_email_address>
MAIL_TLS_REJECT_UNAUTHORIZED=false
MAIL_LOGGER=true
MAIL_DEBUG=false
