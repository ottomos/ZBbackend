# ============================================================================
# MSSQL Database Configuration - SQL Authentication (Default)
# ============================================================================
# Use this configuration if connecting with SQL Server credentials

DB_AUTH_TYPE=default
DB_USER=testuser
DB_PASSWORD=testpassword
DB_SERVER=10.2.128.5
DB_DATABASE=TestDB
DB_PORT=1433
DB_INSTANCE=
DB_ENCRYPT=false
DB_TRUST_CERTIFICATE=true

# ============================================================================
# Kafka Brokers Configuration
# ============================================================================
KAFKA_BROKER_KFH=localhost:9092,localhost:9093,localhost:9094
KAFKA_BROKER_KT=localhost:9092,localhost:9093,localhost:9094
KAFKA_BROKER_AUB=localhost:9092,localhost:9093,localhost:9094

# ============================================================================
# Server Configuration
# ============================================================================
PORT=5000
NODE_ENV=development

# ============================================================================
# Redis Configuration
# ============================================================================

# Production example (from BOACache config):
#   REDIS_CLUSTER_NODES=10.14.4.89:6379,10.14.4.92:6379,10.14.4.90:6379,10.14.4.93:6379,10.14.4.91:6379,10.14.4.94:6379
#   REDIS_PASSWORD=a3d4a53e-ec6a-4a59-bede-4db543ee54cde6fd641d-afc4-483a-855c-e4b1ad52026e
#   REDIS_INSTANCE_NAME=dev.boa
#   REDIS_SYNC_TIMEOUT=10000
#   REDIS_HOST=           (leave empty when cluster nodes are used)
#   REDIS_PORT=           (leave empty when cluster nodes are used)

#Development defaults (single local Redis instance)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_INSTANCE_NAME=kth-dev
REDIS_CLUSTER_NODES=
REDIS_SYNC_TIMEOUT=10000
#Dev defaults End
